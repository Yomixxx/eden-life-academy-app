{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/daily-devotion",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/course-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 12 * * *"
    }
  ]
}
