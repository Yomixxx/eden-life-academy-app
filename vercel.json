{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/daily-devotion",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/keep-in-touch",
      "schedule": "0 7 * * 1,3,5"
    },
    {
      "path": "/api/cron/send-scheduled",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/instagram-post",
      "schedule": "0 8 * * 1,3,5"
    }
  ]
}
