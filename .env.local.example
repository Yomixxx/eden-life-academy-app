# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for links in the app)
NEXT_PUBLIC_APP_URL=

# Cron authentication (Vercel Cron -> API routes)
CRON_SECRET=

# Email — outbound app email (welcome, announcements, course reminders,
# pastoral alerts) is relayed through a Google Apps Script Web App instead
# of raw SMTP. See google-apps-script/Code.gs for the script to deploy and
# where these two values come from.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Where Ask PG pastoral care alerts (crisis-flagged messages) are emailed to
# staff. Required for that feature — there is no fallback address.
PASTORAL_ALERT_EMAIL=
