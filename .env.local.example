# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for links in the app)
NEXT_PUBLIC_APP_URL=

# Cron authentication (Vercel Cron -> API routes)
CRON_SECRET=

# Email (Gmail SMTP via nodemailer) — used only for the welcome email and
# announcement notifications. GMAIL_USER should be communication@edenlifeng.org.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional — where Ask PG pastoral care alerts (crisis-flagged messages) are
# emailed to staff. Falls back to GMAIL_USER if not set.
PASTORAL_ALERT_EMAIL=
