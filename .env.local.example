# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for links in the app)
NEXT_PUBLIC_APP_URL=

# Cron authentication (Vercel Cron -> API routes)
CRON_SECRET=

# Email — outbound app email (welcome, announcements, course reminders,
# devotions, pastoral alerts) is sent via Resend. RESEND_FROM_EMAIL needs a
# verified sending domain in the Resend dashboard; until then it falls back
# to Resend's shared onboarding@resend.dev sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Where Ask PG pastoral care alerts (crisis-flagged messages) are emailed to
# staff. Required for that feature — there is no fallback address.
PASTORAL_ALERT_EMAIL=

# Recipient for the daily health-check canary email that tests the Resend
# relay end-to-end. Falls back to PASTORAL_ALERT_EMAIL if unset.
HEALTH_CHECK_EMAIL=

# Groq API key used to generate the daily devotion content (free tier).
GROQ_API_KEY=

# Optional: an ntfy.sh topic name. If set, health-check failures also push
# an instant phone alert via https://ntfy.sh/<topic> — independent of the
# Resend relay, so it still works if Resend itself is what's broken.
NTFY_ALERT_TOPIC=
